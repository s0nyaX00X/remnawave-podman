# Panel compose and backend environment.
# Values marked change_me are replaced by panel/install.sh when .env is absent.

APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

DATABASE_URL=postgresql://postgres:change_me@remnawave-db:5432/postgres
REDIS_SOCKET=/var/run/valkey/valkey.sock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

APP_SECRET=change_me
WEBHOOK_SECRET_HEADER=change_me

PANEL_DOMAIN=
FRONT_END_DOMAIN=*
SUB_PUBLIC_DOMAIN=

METRICS_USER=admin
METRICS_PASS=change_me
